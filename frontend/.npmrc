# This is a web-only application.
#
# @react-three/fiber v9 declares the React Native / Expo runtime (expo,
# expo-gl, expo-asset, react-native, react-native-web, …) as OPTIONAL peer
# dependencies so the same package can drive a React Native canvas. npm 7+
# tries to resolve optional peers anyway, drags the whole Expo SDK into the
# tree, and then fails on a react-native <-> react version conflict that has
# nothing to do with this project.
#
# legacy-peer-deps stops npm resolving peer dependencies automatically, which
# keeps the tree to the web packages we actually ship. The peers that DO matter
# here (react, react-dom) are pinned directly in package.json and are checked
# by typecheck and the test suite.
legacy-peer-deps=true
